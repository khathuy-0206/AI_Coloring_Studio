# AI Provider configuration ('mock' or 'openai' or custom)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=dall-e-2

# Upload limit (MB)
MAX_UPLOAD_MB=10

# Database Configuration (PostgreSQL in production, SQLite or Postgres in dev)
# For PostgreSQL: postgresql://USER:PASSWORD@HOST:5432/ai_coloring_studio?schema=public
# For Local SQLite: file:./dev.db
DATABASE_URL="file:./dev.db"
